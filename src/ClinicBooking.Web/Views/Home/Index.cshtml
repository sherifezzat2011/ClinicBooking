@model List<AppointmentListItemViewModel>
@{
    ViewData["Title"] = "Home";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>Clinic Booking</h1>
        <p class="text-muted mb-0">Manage patient appointments.</p>
    </div>
    <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary">New appointment</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<section class="card mb-4" aria-labelledby="appointments-heading">
    <div class="card-body">
        <h2 id="appointments-heading" class="h4 mb-3">Saved appointments</h2>
        <partial name="_AppointmentsGrid" model="Model" />
    </div>
</section>

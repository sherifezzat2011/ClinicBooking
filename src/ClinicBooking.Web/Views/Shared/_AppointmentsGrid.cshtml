@model List<AppointmentListItemViewModel>
@using System.Globalization

@if (Model.Count == 0)
{
    <div class="schedule-empty">
        <span class="empty-calendar" aria-hidden="true">+</span>
        <h3>Your schedule starts here</h3>
        <p>No appointments have been booked yet. Choose a doctor and a time to arrange the first visit.</p>
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-outline-primary">Book an appointment</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table clinic-table align-middle mb-0">
            <caption class="visually-hidden">Saved appointments ordered by date and start time.</caption>
            <thead>
                <tr>
                    <th scope="col">Booking #</th>
                    <th scope="col">Patient</th>
                    <th scope="col">Doctor</th>
                    <th scope="col">Date</th>
                    <th scope="col">Start time</th>
                    <th scope="col">End time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    var initial = string.IsNullOrWhiteSpace(appointment.PatientName)
                        ? "?" : appointment.PatientName.Trim()[0].ToString().ToUpperInvariant();
                    <tr>
                        <th scope="row" class="booking-number">#@appointment.Id.ToString("D3", CultureInfo.InvariantCulture)</th>
                        <td><div class="patient-cell"><span class="patient-avatar" aria-hidden="true">@initial</span><span>@appointment.PatientName</span></div></td>
                        <td><span class="doctor-chip"><span class="doctor-symbol" aria-hidden="true">+</span>@appointment.DoctorName</span></td>
                        <td class="text-nowrap">@appointment.StartDateTime.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</td>
                        <td class="text-nowrap">@appointment.StartDateTime.ToString("HH:mm", CultureInfo.InvariantCulture)</td>
                        <td class="text-nowrap">@appointment.EndDateTime.ToString("HH:mm", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

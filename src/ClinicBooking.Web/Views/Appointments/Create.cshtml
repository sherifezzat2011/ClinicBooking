@model CreateAppointmentViewModel
@{
    ViewData["Title"] = "New appointment";
    var today = DateOnly.FromDateTime(DateTime.Today)
        .ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}

<nav class="page-breadcrumb" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index">Appointments</a><span aria-hidden="true">/</span><span aria-current="page">New appointment</span></nav>
<div class="booking-heading">
    <span class="eyebrow">LET'S MAKE TIME FOR YOUR HEALTH</span>
    <h1>Plan your next visit.</h1>
    <p>Tell us a little about the patient, then choose a doctor and a time that works.</p>
</div>

<div class="booking-layout">
    <div class="booking-main">
        @if (Model.Doctors.Count == 0)
        {
            <div class="alert alert-danger" role="status">No doctors are available for selection.</div>
        }
        <form asp-controller="Appointments" asp-action="Create" method="post" class="booking-form">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary" role="alert"></div>
            <section class="form-section" aria-labelledby="patient-heading">
                <div class="form-section-heading"><span class="section-number" aria-hidden="true">01</span><div><h2 id="patient-heading">Patient details</h2><p>A few details to get the visit started.</p></div><span class="required-note">* Required fields</span></div>
                <div class="form-section-body">
                    <div class="mb-4">
                        <label asp-for="PatientName" class="form-label required-label"></label>
                        <input asp-for="PatientName" class="form-control" maxlength="150" autocomplete="name" placeholder="Patient's full name" aria-required="true" />
                        <span asp-validation-for="PatientName" class="text-danger"></span>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="BirthDate" class="form-label required-label"></label>
                            <input asp-for="BirthDate" class="form-control" max="@today" autocomplete="bday" aria-required="true" />
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label><span class="optional-label">Optional</span>
                            <input asp-for="Phone" class="form-control" type="tel" maxlength="30" autocomplete="tel" placeholder="Phone number" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>
            <section class="form-section" aria-labelledby="visit-heading">
                <div class="form-section-heading"><span class="section-number" aria-hidden="true">02</span><div><h2 id="visit-heading">Visit details</h2><p>Find the right time for your appointment.</p></div></div>
                <div class="form-section-body">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DoctorId" class="form-label required-label"></label>
                            <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select" aria-required="true"><option value="">Select a doctor</option></select>
                            <span asp-validation-for="DoctorId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label required-label"></label>
                            <input asp-for="AppointmentDate" class="form-control" min="@today" aria-required="true" />
                            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="AppointmentTime" class="form-label required-label"></label>
                        <select asp-for="AppointmentTime" asp-items="Model.AvailableTimes" class="form-select"
                                disabled="@(Model.AvailableTimes.Count == 0)" aria-describedby="visit-duration" aria-required="true"
                                data-slots-url="@Url.Action("AvailableSlots", "Appointments")"><option value="">Select an available time</option></select>
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                        <div id="visit-duration" class="form-text"><span class="tiny-clock" aria-hidden="true"></span> Default visit length: 30 minutes.</div>
                        <div id="availability-message" class="alert alert-danger mt-3 mb-0" role="status"
                             hidden="@(string.IsNullOrEmpty(Model.AvailabilityMessage))">@Model.AvailabilityMessage</div>
                    </div>
                </div>
            </section>
            <div class="form-actions"><a asp-controller="Home" asp-action="Index" class="back-link"><span aria-hidden="true">&#8592;</span> Back to appointments</a><button type="submit" class="btn btn-primary">Save appointment <span aria-hidden="true">&#8594;</span></button></div>
        </form>
    </div>
    <aside class="booking-aside" aria-label="Booking guidance">
        <div class="visit-guide">
            <img src="~/images/clinic-room.svg" alt="A welcoming clinic reception." class="guide-image" />
            <div class="guide-content"><span class="eyebrow">A LITTLE PEACE OF MIND</span><h2>Your visit,<br />thoughtfully planned.</h2><p>A clear schedule leaves more room for what matters: taking care of you.</p>
                <div class="visit-duration"><span class="duration-icon" aria-hidden="true">&#9719;</span><div><strong>30-minute visits</strong><span>Default appointment length</span></div></div>
                <ol class="guide-steps"><li>Choose your doctor.</li><li>Pick a date and an available time.</li><li>Save your appointment.</li></ol>
            </div>
        </div>
        <p class="booking-tip"><span aria-hidden="true">+</span> Only free times within your doctor's working hours are shown.</p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment-form.js" asp-append-version="true"></script>
}
